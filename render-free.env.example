# Separate from the existing paid CPU render.env.example. Never deploy before smoke passes.
AI_SERVICE_TOKEN=
# Your OWN verified CPU service's HTTPS root URL (no /chat suffix).
NATLAS_REMOTE_URL=
# Match AI_SERVICE_TOKEN on that CPU host, not this gateway's incoming token.
NATLAS_REMOTE_TOKEN=
# Copy the verified manifest hash from the CPU preparation report.
NATLAS_MANIFEST_SHA256=
NATLAS_BACKEND=remote
NATLAS_ENABLED=true
NATLAS_MAX_NEW_TOKENS=128
NATLAS_TIMEOUT_SECONDS=130
REQUEST_TIMEOUT_SECONDS=30
HF_LOCAL_FILES_ONLY=true
PORT=10000
