# CHAT SERVICE (Dockerfile ./Dockerfile; port 10000; persistent disk /data)
AI_SERVICE_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
HF_TOKEN=read-only-token-for-the-private-verified-artifact-repository
HF_HOME=/data/huggingface
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_PROGRESS_BARS=1
HF_LOCAL_FILES_ONLY=false
NATLAS_BACKEND=gguf
NATLAS_ENABLED=true
NATLAS_MANAGED_ARTIFACT=false
NATLAS_REQUIRE_VERIFIED_ARTIFACT=true
NATLAS_ARTIFACT_DIR=/data/natlas/model
NATLAS_GGUF_REPO=your-org/official-natlas-q4-k-m
NATLAS_GGUF_REVISION=replace-with-a-40-character-commit-sha
NATLAS_MANIFEST_SHA256=replace-with-the-64-character-manifest-sha256
NATLAS_CONTEXT_SIZE=2048
NATLAS_MAX_INPUT_TOKENS=1792
NATLAS_MAX_NEW_TOKENS=128
NATLAS_THREADS=4
NATLAS_BATCH_SIZE=64
NATLAS_TIMEOUT_SECONDS=180
PORT=10000

# SPEECH SERVICE (Dockerfile ./Dockerfile.speech; port 10000; persistent disk /data)
# Use a separate AI_SERVICE_TOKEN and a separate HF_TOKEN with access to the four
# official gated NCAIR speech repositories. Do not reuse the chat artifact token.
# In the speech service's own Render environment set:
# AI_SERVICE_TOKEN=<different random secret>
# HF_TOKEN=<speech model read token>
# HF_HOME=/data/huggingface
# ASR_DEVICE=cpu
# ENABLED_LANGUAGES=yo,en-NG,ha,ig
# PORT=10000
