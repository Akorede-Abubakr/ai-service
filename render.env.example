# Phase 1: Docker Web Service, 4c-32g, 80 GB disk /data, health /live.
# Phase 2 after verified preparation: mode serve, health /health, 4c-16g.
AI_SERVICE_TOKEN=
# Read-only token with access to the OFFICIAL gated NCAIR1/N-ATLaS repo.
HF_TOKEN=
HF_HOME=/data/huggingface
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_PROGRESS_BARS=1
NATLAS_SETUP_MODE=prepare
NATLAS_ENABLED=true
NATLAS_BACKEND=gguf
NATLAS_MANAGED_ARTIFACT=true
NATLAS_ARTIFACT_DIR=/data/natlas/model
NATLAS_PREPARE_WORK_DIR=/data/natlas/work
NATLAS_PREPARE_TIMEOUT_SECONDS=21600
# Runtime offline; preparation subprocess downloads directly with HF_TOKEN.
HF_LOCAL_FILES_ONLY=true
NATLAS_CONTEXT_SIZE=2048
NATLAS_MAX_INPUT_TOKENS=1920
NATLAS_MAX_NEW_TOKENS=128
NATLAS_THREADS=4
NATLAS_BATCH_SIZE=128
NATLAS_TIMEOUT_SECONDS=120
REQUEST_TIMEOUT_SECONDS=30
PORT=10000
# No externally prepared GGUF or GGUF repository is needed.
# NATLAS_MANIFEST_SHA256 is optional: preparation records it on the disk.
